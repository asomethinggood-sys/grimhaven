# ── Grimhaven / نبرد جاودانگان و تسخیر آسمان ──────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Telegram Bot token from @BotFather  (bot: @Grimheaven_bot)
TELEGRAM_BOT_TOKEN=123456789:AA...replace-me...

# Comma-separated Telegram user ids allowed to open the God-Mode panel (/admin)
ADMIN_IDS=123456789

# Path of the SQLite database file (JSON documents, Mongo-style schema)
DATABASE_PATH=data/grimhaven.db

# Optional: run with WEBHOOK instead of long-polling
# WEBHOOK_URL=https://your.domain/webhook
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=8080

# Web demo console (playable in a browser, same game engine)
DEMO_HOST=0.0.0.0
DEMO_PORT=8000

# ── Artwork subsystem (event illustrations sent as Telegram photos) ─────────
# Full guide: docs/ARTWORK.md. Everything here is optional — the built-in
# providers (Wikimedia Commons, Openverse) need NO key and no paid service,
# and the game plays perfectly with the whole block removed.
# Master switch (0 = never attach pictures; every artwork hook no-ops)
ARTWORK_ENABLED=1
# Cache directory for downloaded files (the index lives in the SQLite DB)
ARTWORK_DIR=assets/artwork
# Ordered provider chain. Known: commons, openverse, pixabay.
# (Pinterest: no public search API exists — see docs/ARTWORK.md §"Sources".)
ARTWORK_PROVIDERS=commons,openverse
# Network behaviour
ARTWORK_TIMEOUT=12
ARTWORK_MAX_RETRIES=2
ARTWORK_CONCURRENCY=3
ARTWORK_TASK_TIMEOUT=45
# Validation gates
ARTWORK_MIN_WIDTH=480
ARTWORK_MAX_SIDE=10000
ARTWORK_MAX_BYTES=5000000
# Cache policy: LRU cap on stored assets; cooldown before a failed asset key
# is retried (minutes)
ARTWORK_MAX_ASSETS=400
ARTWORK_FAIL_COOLDOWN_MINUTES=30
# Identify the bot politely to the provider APIs (Wikimedia etiquette)
#ARTWORK_USER_AGENT=GrimhavenBot/1.0 (contact: you@example.com)
# Openverse licence filter (modification-friendly, no ND/NC by default)
OPENVERSE_LICENSES=cc0,pdm,by,by-sa
# Optional free key from https://pixabay.com/api/docs/ (disabled while empty)
#PIXABAY_API_KEY=
